{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C: gcc build",
            "type": "shell",
            "command": "/usr/bin/gcc",
            "args": [
                "${file}",
                "-g",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}